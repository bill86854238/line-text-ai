{
  "name": "line-text-ai",
  "version": "1.0.0",
  "description": "LINE Text Chat Assistant using Node.js and Cloud Functions",
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc",
    "start": "functions-framework --target=lineWebhook --source=dist/handler.js",
    "dev": "concurrently \"tsc -w\" \"functions-framework --target=lineWebhook --source=dist/handler.js\"",
    "deploy": "gcloud functions deploy line-text-ai --gen2 --runtime=nodejs20 --region=asia-northeast1 --source=. --entry-point=lineWebhook --trigger-http --allow-unauthenticated"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.3.0",
    "@google/generative-ai": "^0.1.3",
    "@line/bot-sdk": "^9.0.0",
    "dotenv": "^16.3.1",
    "groq-sdk": "^0.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}